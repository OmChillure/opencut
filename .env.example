# Supabase Postgres (session pooler, port 5432)
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=opencut-media


# Optional. Folder of director *.md briefs (default: ./prompts).
# OPENCUT_PROMPTS_DIR=/path/to/prompts

# Local STT: ffmpeg + faster-whisper (base is in data/whisper/faster-whisper-base).
# WHISPER_MODEL_DIR=data/whisper/faster-whisper-base
# WHISPER_PYTHON=/path/to/venv/bin/python
# WHISPER_MODEL=base

# Optional Sarvam TTS only (not used for transcribe)
# SARVAM_API_KEY=

# AI uses local CLI subscriptions (same as cbot). No API keys.
# Sign in once: `grok`  |  `claude auth login`  |  `codex`
# Optional HTTP fallback only:
# XAI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# API
API_BIND=0.0.0.0:8787
RUST_LOG=info,opencut_api=debug,opencut_worker=debug
