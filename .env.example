# Supabase Postgres (session pooler, port 5432)
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=opencut-media


# Optional. Folder of director *.md briefs (default: ./prompts).
# OPENCUT_PROMPTS_DIR=/path/to/prompts

# Speech-to-text. Groq Whisper, then local Whisper if Groq is unset.
# GROQ_API_KEY=
# OPENCUT_STT_LANG=en
# Local fallback: ffmpeg + faster-whisper (base is in data/whisper/faster-whisper-base).
# WHISPER_MODEL_DIR=data/whisper/faster-whisper-base
# WHISPER_PYTHON=/path/to/venv/bin/python
# WHISPER_MODEL=base
# WHISPER_TIMEOUT_SECS=180

# Director chat and shot labels use a local CLI subscription. No API key for those.
# Sign in once: `claude auth login`  |  `grok`  |  `codex`
# Shot labels try Claude, then Grok, then Codex.
# B-roll and motion design use the signed-in `grok` login. No API key.
# Grok: `grok agent stdio`.
# Claude ACP: `npm i -g @agentclientprotocol/claude-agent-acp`
#   (binary: claude-agent-acp). Optional override: OPENCUT_CLAUDE_ACP=/full/path
# Codex ACP: install `codex-acp` or set OPENCUT_CODEX_ACP. OPENCUT_ACP_NPX=1 allows npx.
# OpenCut tools (list_bin, split, assemble, …) are an MCP server: `oc-api mcp`.
# ACP session/new attaches that automatically.

# API
API_BIND=0.0.0.0:8787
# Keep api+worker pools small; session pooler slots are limited.
# DB_MAX_CONNECTIONS=4
# Crate names are oc_api / oc_providers / oc_worker — not opencut_api.
RUST_LOG=info,oc_api=debug,oc_providers=debug,oc_worker=debug,oc_db=info
